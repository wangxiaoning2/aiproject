# 复制成 .env 后填入真实值（Node 22 支持 --env-file，也可以用你自己的方式加载）
# 不填 LLM_API_KEY 会自动进入 mock 模式，照样能跑

# 任何 OpenAI 兼容端点都可以：DeepSeek / 通义 / 智谱 / Kimi / 本地 Ollama …
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 强制走本地 mock（不花钱）
# LLM_MOCK=1

# 让上游返回真实 usage。个别服务商不支持这个字段，报错就去掉
# LLM_INCLUDE_USAGE=1

# 上下文预算，超出就裁剪最老的消息
MAX_CONTEXT_TOKENS=8000

# 价格表（元 / 百万 token），用来估算成本
PRICE_IN=2
PRICE_OUT=8

# ---------------- 知识库（RAG）----------------
# 一次召回几段资料。这个数字直接决定"小抄"有多长，也直接决定成本
RAG_TOP_K=4

# 嵌入模型。留空就用本地伪嵌入（零成本，但只有字面能力）
# ⚠ DeepSeek 没有嵌入接口，真实嵌入请用通义 / 智谱 / OpenAI，或本地 Ollama
# 通义：   EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#          EMBED_MODEL=text-embedding-v3
# 智谱：   EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#          EMBED_MODEL=embedding-3
# Ollama： EMBED_BASE_URL=http://localhost:11434/v1
#          EMBED_MODEL=bge-m3
#
# 换嵌入模型后必须重建索引（node rag/ingest.ts），否则查询和文档不在同一个向量空间里

# EMBED_MODEL=
# EMBED_BASE_URL=
# EMBED_API_KEY=

# 强制用本地伪嵌入，哪怕配了上面几项
# EMBED_MOCK=1

PORT=5173
